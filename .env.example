NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Chave service role (NUNCA expor ao client). Necessária para as rotas da Agenda.
# IMPORTANTE: Esta chave NÃO deve começar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# URL pública do site (usada nos redirects do OAuth e e-mails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar OAuth (Google Cloud Console -> APIs & Services -> Credentials).
GOOGLE_CALENDAR_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/schedule/google/callback

# Chave para criptografar tokens do Google (hex de 32 bytes).
# Gere com: openssl rand -hex 32
SCHEDULE_TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_HEX_KEY
